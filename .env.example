# ─── Firebase (Authentication) ───────────────────────────────
# Get these from Firebase Console → Project settings → Your apps → Web app config.
# Copy this file to `.env`, fill in the values, then restart `expo start -c`.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ─── Google Sign-In (OAuth client IDs) ───────────────────────
# Create OAuth client IDs in Google Cloud Console (or Firebase Auth → Google).
# The web client ID is also used by Firebase to verify Google credentials.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ─── RevenueCat (In-App Purchases) ───────────────────────────
# Optional until you wire real purchases. Set keys in lib/purchases.ts.
# (Apple sign-in needs no keys here — it uses your Apple Developer team config.)
